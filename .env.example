# API Configuration
VITE_API_URL=https://api.aimploy.org/api/v1
VITE_API_BASE_URL=https://api.aimploy.org/api/v1

# Frontend URL
VITE_FRONTEND_URL=http://localhost:5173

# Environment
VITE_NODE_ENV=development

# DigiLocker Configuration (for production)
# VITE_DIGILOCKER_API_URL=https://dg.setu.co
# VITE_DIGILOCKER_CLIENT_ID=your-digilocker-client-id
# VITE_DIGILOCKER_CLIENT_SECRET=your-digilocker-client-secret
# VITE_DIGILOCKER_PRODUCT_INSTANCE_ID=your-product-instance-id

# Add other environment variables here as needed
# VITE_GOOGLE_CLIENT_ID=your-google-client-id
# VITE_GOOGLE_REDIRECT_URI=your-google-redirect-uri
